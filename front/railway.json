  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "front/Dockerfile"
  },
  "deploy": {
    "startCommand": "node server/production.cjs",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },

        "VITE_SIGNALR_URL": "https://pregiato-api-production.up.railway.app/hubs/whatsapp",
        "VITE_CLERK_PUBLISHABLE_KEY": "pk_test_c21pbGluZy1tYW1tb3RoLTYuY2xlcmsuYWNjb3VudHMuZGV2JA",
        "VITE_DEV_MODE": "false",
        "VITE_ENABLE_CLERK": "true",
        "DATABASE_URL": "${{DATABASE_URL}}"
      }
    }
  }
}
